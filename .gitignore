builder-debug.yml

# playwright artifacts
frontend/test-results/
frontend/e2e-artifacts/
/output/

# built daemon binary copied into the frontend bundle dir
frontend/daemon/
frontend/resources/acp-runtime/

# pinned native browser automation binary copied during package preparation
frontend/agent-browser/

# Locally-added agent skills (not for the team), except curated project skills
.agents/
!.agents/
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/ao-desktop-dev/
