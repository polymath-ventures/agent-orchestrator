[Unit]
Description=Agent Orchestrator daemon
After=network-online.target ao-tmux.service
Wants=network-online.target
Requires=ao-tmux.service
StartLimitIntervalSec=0

[Service]
Type=simple
# Refuse to be the first process to touch AO's tmux socket. A lazily spawned
# tmux server inherits the daemon unit's cgroup, and then a routine daemon
# restart can kill every live agent pane before AO can reattach them. The gate
# probes $AO_DATA_DIR/run/tmux/default, the socket the runtime adapter actually
# uses (issue #160) — probing tmux's default socket would pass while protecting
# nothing. The path is derived from AO_DATA_DIR (set below), not written out, so
# a drop-in override moves the daemon and its ownership gate together.
#
# The bare `tmux list-sessions` fallback is transitional: deploy.sh restarts
# ao.service but cannot restart ao-tmux.service (RefuseManualStop=yes), so on
# the deploy that moves the socket the AO-socket server does not exist yet while
# the legacy one still holds the live fleet. Accepting it keeps that deploy from
# bricking the daemon. Drop the fallback once the legacy server is drained (see
# docs/fork.md).
ExecStartPre=/bin/sh -c 'if ! command -v tmux >/dev/null 2>&1; then echo "ao.service: refusing to start: tmux is not installed; install tmux and start ao-tmux.service first" >&2; exit 127; fi; if tmux -S "$AO_DATA_DIR/run/tmux/default" list-sessions >/dev/null 2>&1; then exit 0; fi; if tmux list-sessions >/dev/null 2>&1; then echo "ao.service: no server on AO tmux socket yet; proceeding on the legacy default socket (issue #160 migration)" >&2; exit 0; fi; if tmux -S "$AO_DATA_DIR/run/tmux/default" list-sessions 2>&1 | grep -qiE "error connecting|no server running|no such file"; then echo "ao.service: refusing to start: no tmux server owns the AO tmux socket; start ao-tmux.service first" >&2; exit 1; fi; echo "ao.service: refusing to start: tmux ownership probe failed" >&2; tmux -S "$AO_DATA_DIR/run/tmux/default" list-sessions 2>&1 | sed "s/^/  /" >&2; exit 2'
ExecStart=%h/.local/bin/ao daemon
Restart=always
RestartSec=5s
Environment=AO_DATA_DIR=%h/.ao/data
Environment=AO_RUN_FILE=%h/.ao/running.json
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

# Only signal the daemon's main process on restart. Agent panes live under
# ao-tmux.service, and legacy tmux servers may still be in this cgroup until the
# next host reboot, so cgroup-wide stop semantics are explicitly avoided.
KillMode=process
TimeoutStopSec=60s

[Install]
WantedBy=default.target
